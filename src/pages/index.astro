---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE } from '../config';
import { projects } from '../data/projects';
import { toWorkRows } from '../lib/work';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}${p}`;
const projectsUrl = `${base}/projects/`;

const firstName = SITE.name.split(' ')[0];
const rows = toWorkRows(projects, base);
const featured = rows.slice(0, 5);
---

<SiteLayout title={`${SITE.name} · ${SITE.tagline}`} description={SITE.description}>
  <header class="hero" id="top">
    <div class="wrap">
      <span class="eyebrow reveal">Freelance AI Product Builder</span>
      <h1 class="reveal" data-d="1">I build AI products <span class="it">end to end.</span></h1>
      <div class="hero__sub reveal" data-d="2">
        <p>
          I'm {firstName}, a <b>freelance AI product builder</b>. I build
          AI-powered products full time. Below is a selection of the things I've
          made and the problems they were built to solve.
        </p>
        <div class="hero__meta">
          <b>{projects.length} products</b><br />for clients, family & community
        </div>
      </div>
    </div>
  </header>

  <section class="section" id="work" style="padding-top:0;">
    <div class="wrap">
      <div class="shead reveal"><h2>Selected <span class="it">work</span></h2><a class="ghost" href={projectsUrl}>All projects</a></div>
      <div class="work-grid">
        {featured.map((p, i) => (
          <a class={`work-card reveal${i === 0 ? ' work-card--feature' : ''}`} href={p.href} style={`--c:${p.color};`}>
            <div class="work-card__img">
              {p.image
                ? <img src={asset(p.image)} alt={p.title} loading="lazy" />
                : <div class="work-card__ph"><span>{p.name}</span></div>}
            </div>
            <div class="work-card__body">
              <span class="work-card__name">{p.name} <span class="arrow">↗</span></span>
              <span class="work-card__tag">{p.audience}</span>
            </div>
            <p class="work-card__blurb">{p.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap about__grid">
      <h2 class="reveal">I take AI-powered products from <span class="it">idea</span> to something people use.</h2>
      <div class="about__body reveal" data-d="1">
        <p>
          I'm {firstName}, a <b>freelance AI product builder</b>. I start with a
          rough idea, shape it into a real product, and stay with it until it's
          live and in people's hands.
        </p>
        <p>
          The same care goes into every project, whether it's an internal tool
          that turns days of work into about twenty minutes, a marketplace that
          keeps good toys out of landfill, or a journaling app for new mothers
          finding their feet.
        </p>
        <div class="about__facts">
          <div><b>{projects.length}</b><span>Products shipped</span></div>
          <div><b>03</b><span>Audiences served</span></div>
          <div><b>AI</b><span>At the core</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section endcta" id="contact">
    <div class="wrap">
      <span class="eyebrow reveal">Got a problem worth building?</span>
      <h2 class="reveal" data-d="1">Let's <span class="it">build</span> something.</h2>
      <div class="row reveal" data-d="2">
        <a class="cta" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a class="ghost" href="#top">Back to top</a>
      </div>
    </div>
  </section>
</SiteLayout>
