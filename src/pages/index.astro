---
import SiteLayout from '../layouts/SiteLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE } from '../config';
import { visibleProjects } from '../data/projects';
import { toWorkRows } from '../lib/work';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}${p}`;
const projectsUrl = `${base}/projects/`;

const firstName = SITE.name.split(' ')[0];
const rows = toWorkRows(visibleProjects, base);
const featured = rows.slice(0, 5);
---

<SiteLayout title={`${SITE.name} · ${SITE.tagline}`} description={SITE.description}>
  <header class="hero" id="top">
    <div class="wrap hero__grid">
      <div class="hero__intro">
        <h1 class="reveal">Hi, I'm {firstName}.</h1>
        <p class="hero__lead reveal" data-d="1">
          I'm a freelance product builder. I help turn ideas into products
          people actually use, from client platforms to the internal tools that
          quietly save a team hours every week.
        </p>
        <p class="hero__aside reveal" data-d="2">
          I use AI heavily, and I can help you learn to do the same.
        </p>
        <div class="hero__cta reveal" data-d="2">
          <a class="cta" href="#work">See the work</a>
          <a class="ghost" href={SITE.bookingUrl} target="_blank" rel="noopener">Book a call</a>
        </div>
      </div>
      <figure class="hero__photo reveal" data-d="1">
        <img src={asset('/zimo.jpg')} alt={`Portrait of ${SITE.name}`} width="1000" height="1200" />
      </figure>
    </div>
  </header>

  <section class="section" id="work">
    <div class="wrap">
      <div class="shead reveal"><h2>Selected work</h2><a class="textlink" href={projectsUrl}>All projects →</a></div>
      <div class="work-grid">
        {featured.map((p, i) => <WorkCard p={p} feature={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="section about" id="about">
    <div class="wrap about__grid">
      <h2 class="reveal">How I work</h2>
      <div class="about__body reveal" data-d="1">
        <p>
          I'm usually the person who takes a vague brief and turns it into
          something live. On client projects that's meant leading the build, as
          on Recht in Beeld, or running the product and then writing the
          features myself, as on BandBridge. On the agency side it's meant
          internal tools that save hours every week.
        </p>
        <p>
          I like small scopes, early demos and talking to the people who'll
          actually use the thing. AI does a lot of the heavy lifting, but the
          job is still figuring out what's worth building.
        </p>
      </div>
    </div>
  </section>

  <section class="section endcta" id="contact">
    <div class="wrap">
      <h2 class="reveal">Building something?</h2>
      <p class="endcta__lede reveal" data-d="1">
        Whether you want me to build it or want support building it yourself,
        reach out. Book a call, or email me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
      <div class="row reveal" data-d="2">
        <a class="cta" href={SITE.bookingUrl} target="_blank" rel="noopener">Book a call</a>
        <a class="ghost" href={`mailto:${SITE.email}`}>Send an email</a>
      </div>
    </div>
  </section>
</SiteLayout>
