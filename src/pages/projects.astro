---
import SiteLayout from '../layouts/SiteLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE } from '../config';
import { visibleProjects } from '../data/projects';
import { toWorkRows } from '../lib/work';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = toWorkRows(visibleProjects, base);

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: rows.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    url: new URL(p.href, Astro.site).toString(),
  })),
};
---

<SiteLayout
  title={`Projects · ${SITE.name}`}
  description={`Selected work by ${SITE.name}: client products, internal tools and side projects, from first idea to launch.`}
  schema={listSchema}
>
  <section class="section pagetop">
    <div class="wrap">
      <div class="shead reveal"><h2>All projects</h2></div>
      <p class="lede reveal">
        Client builds, internal agency tools and a side project of my own.
        Each one has a short write-up.
      </p>
      <div class="work-grid">
        {rows.map((p) => <WorkCard p={p} />)}
      </div>
    </div>
  </section>
</SiteLayout>
