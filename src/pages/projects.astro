---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE } from '../config';
import { visibleProjects } from '../data/projects';
import { toWorkRows } from '../lib/work';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}${p}`;
const rows = toWorkRows(visibleProjects, base);

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: rows.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    url: new URL(p.href, Astro.site).toString(),
  })),
};
---

<SiteLayout
  title={`Projects · ${SITE.name}`}
  description={`Selected work by ${SITE.name}: products taken from a rough idea to shipped, end to end.`}
  schema={listSchema}
>
  <section class="section pagetop">
    <div class="wrap">
      <div class="shead reveal"><h2>All <span class="it">projects</span></h2></div>
      <p class="lede reveal">
        Everything I've built, from agentic internal tools to marketplaces and
        RAG search. Select any project for the full write-up.
      </p>
      <div class="work-grid">
        {rows.map((p) => (
          <a class="work-card reveal" href={p.href} style={`--c:${p.color};`}>
            <div class="work-card__img">
              {p.image
                ? <img src={asset(p.image)} alt={p.title} loading="lazy" />
                : <div class="work-card__ph"><span>{p.name}</span></div>}
            </div>
            <div class="work-card__body">
              <span class="work-card__name">{p.name} <span class="arrow">↗</span></span>
              <span class="work-card__tag">{p.audience}</span>
            </div>
            <p class="work-card__blurb">{p.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
