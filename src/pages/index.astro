---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE } from '../config';
import { visibleProjects } from '../data/projects';
import { toWorkRows } from '../lib/work';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}${p}`;
const projectsUrl = `${base}/projects/`;

const firstName = SITE.name.split(' ')[0];
const rows = toWorkRows(visibleProjects, base);
const featured = rows.slice(0, 5);
---

<SiteLayout title={`${SITE.name} · ${SITE.tagline}`} description={SITE.description}>
  <header class="hero" id="top">
    <div class="wrap hero__grid">
      <div class="hero__intro">
        <span class="eyebrow reveal">Freelance · AI-native Product Builder</span>
        <h1 class="reveal" data-d="1">I build products <span class="it">end to end.</span></h1>
        <p class="hero__lead reveal" data-d="2">
          I'm {firstName}, a freelance, AI-native product builder. I take a rough
          idea and carry it all the way to something live and in use. Below is a
          selection of what I've made.
        </p>
        <div class="hero__cta reveal" data-d="2">
          <a class="cta" href="#work">See the work</a>
          <a class="ghost" href="#contact">Get in touch</a>
        </div>
      </div>
      <div class="hero__photo reveal" data-d="1">
        <img src={asset('/zimo.jpg')} alt={SITE.name} width="1379" height="1600" />
      </div>
    </div>
  </header>

  <section class="section" id="work">
    <div class="wrap">
      <div class="shead reveal"><h2>Selected <span class="it">work</span></h2><a class="ghost" href={projectsUrl}>All projects</a></div>
      <div class="work-grid">
        {featured.map((p, i) => (
          <a class={`work-card reveal${i === 0 ? ' work-card--feature' : ''}`} href={p.href} style={`--c:${p.color};`}>
            <div class="work-card__img">
              {p.image
                ? <img src={asset(p.image)} alt={p.title} loading="lazy" />
                : <div class="work-card__ph"><span>{p.name}</span></div>}
            </div>
            <div class="work-card__body">
              <span class="work-card__name">{p.name} <span class="arrow">↗</span></span>
              <span class="work-card__tag">{p.audience}</span>
            </div>
            <p class="work-card__blurb">{p.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap about__grid">
      <h2 class="reveal">I take products from a <span class="it">rough idea</span> to something people use.</h2>
      <div class="about__body reveal" data-d="1">
        <p>
          I'm {firstName}, a freelance, <b>AI-native product builder</b>. I start
          with a rough idea, shape it into a real product, and stay with it until
          it's live and in people's hands.
        </p>
        <p>
          The same care goes into every project, from internal tools that turn
          days of work into minutes to full platforms built from scratch. Always
          the shortest line between a real problem and something people can use.
        </p>
      </div>
    </div>
  </section>

  <section class="section endcta" id="contact">
    <div class="wrap">
      <span class="eyebrow reveal">Got a problem worth building?</span>
      <h2 class="reveal" data-d="1">Let's <span class="it">build</span> something.</h2>
      <div class="row reveal" data-d="2">
        <a class="cta" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a class="ghost" href="#top">Back to top</a>
      </div>
    </div>
  </section>
</SiteLayout>
